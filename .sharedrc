alias cd='z'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias mpdvd='mplayer dvdnav:// -dvd-device /dev/sr0'
alias smpdvd='smplayer dvdnav://0 -dvd-device /dev/sr0'

lockspend() {
	swaylock & systemctl suspend
}

gits() {
	git status
}

convert_to_dvr() {
	ffmpeg -i $1 -c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p -c:a alac $2
}

dvr() {
	/opt/resolve/bin/resolve
}

bar() {
	if ps -e | grep waybar > /dev/null
	then
		pkill waybar
	else
		waybar & disown
	fi
}

venv() {
	source $(fd -I activate$)
}

qm() {
	sudo mount $1 $2 -o uid=1000
}

# wallpaper select
setwallpaper() {
	echo "$1" > ~/dotfiles/.wallpaper
	awww img $(cat ~/dotfiles/.wallpaper)
}

nvmi() {
	. /usr/share/nvm/init-nvm.sh
}

encin() {
	gpg -ea | wl-copy -t text/plain
}
encout() {
	wl-paste | gpg -d
}

cargadd() {
	if [ $1 ]; then
		if [ -f Cargo.toml ]; then
			if [ ! -f src/$1.rs ]; then
				echo "[[bin]]\nname=\"$1\"\npath=\"src/$1.rs\"" >> Cargo.toml
				cp ~/dotfiles/scripts/rs_io_template.rs src/$1.rs
			else
				echo -e "\e[31merror: \e[0mfile exists"
			fi;
		else
			echo -e "\e[31merror: \e[0mno Cargo.toml found"
		fi;
	else
		echo -e "\e[31merror: \e[0mno name specified"
	fi;
}
