alias cd='z'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias mpdvd='mplayer dvdnav:// -dvd-device /dev/sr0'
alias smpdvd='smplayer dvdnav://0 -dvd-device /dev/sr0'

gits() {
	git status
}

convert_to_dvr() {
	ffmpeg -i $1 -c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p -c:a alac $2
}

dvr() {
	/opt/resolve/bin/resolve
}

bar() {
	if ps -e | grep waybar > /dev/null
	then
		pkill waybar
	else
		waybar & disown
	fi
}

# wallpaper select
setwallpaper() {
	echo "$1" > ~/dotfiles/.wallpaper
	swww img $(cat ~/dotfiles/.wallpaper)
}

